---
import profile from "../assets/images/profile.jpg";
---

<section class="hero">

  <div class="container hero-grid">

    <div>

      <span class="tag">
        👋 Halo, saya
      </span>

      <h1>
        Muhammad Ilham
        <br />
        <span>Dimas Meidi</span>
      </h1>

      <p>
        Mahasiswa Sistem Informasi yang fokus pada pengembangan website modern
        menggunakan Laravel, PHP, JavaScript, MySQL, Bootstrap, Tailwind CSS,
        dan Astro.
      </p>

      <div class="buttons">

        <a
          href="https://github.com/dims154"
          target="_blank"
          class="btn btn-primary">

          🐙 GitHub

        </a>

        <a
          href="#projects"
          class="btn btn-outline">

          🚀 View Projects

        </a>

      </div>

      <div class="status">
        <span class="dot"></span>
        Available for Internship & Freelance
      </div>

      <div class="stats">

        <div>
          <h2>10+</h2>
          <span>Projects</span>
        </div>

        <div>
          <h2>7+</h2>
          <span>Technologies</span>
        </div>

        <div>
          <h2>∞</h2>
          <span>Learning</span>
        </div>

      </div>

    </div>

    <div class="profile">

      <img
        src={profile.src}
        alt="Muhammad Ilham Dimas Meidi"
        class="avatar"
      />

    </div>

  </div>

</section>

<style>

.hero{
    padding-top:170px;
    min-height:100vh;
    display:flex;
    align-items:center;
}

.hero-grid{
    display:grid;
    grid-template-columns:1fr 450px;
    align-items:center;
    gap:60px;
}

.hero h1{
    font-size:68px;
    line-height:1.1;
    margin:20px 0;
}

.hero h1 span{
    color:var(--primary);
}

.hero p{
    color:var(--muted);
    line-height:1.9;
    margin:25px 0;
    max-width:620px;
}

.buttons{
    display:flex;
    gap:20px;
    margin-top:35px;
    flex-wrap:wrap;
}

/* STATUS */

.status{
    margin-top:30px;
    display:inline-flex;
    align-items:center;
    gap:10px;
    padding:12px 20px;
    border-radius:999px;
    background:rgba(34,197,94,.08);
    border:1px solid rgba(34,197,94,.25);
    color:#86efac;
    font-size:15px;
    font-weight:600;
}

.dot{
    width:10px;
    height:10px;
    border-radius:50%;
    background:#22c55e;
    animation:pulse 1.8s infinite;
}

@keyframes pulse{
    0%{
        box-shadow:0 0 0 0 rgba(34,197,94,.6);
    }

    70%{
        box-shadow:0 0 0 12px rgba(34,197,94,0);
    }

    100%{
        box-shadow:0 0 0 0 rgba(34,197,94,0);
    }
}

/* STATS */

.stats{
    display:flex;
    gap:45px;
    margin-top:40px;
    flex-wrap:wrap;
}

.stats h2{
    margin:0;
    font-size:34px;
    color:var(--primary);
}

.stats span{
    color:var(--muted);
    font-size:15px;
}

/* PROFILE */

.profile{
    position:relative;
    display:flex;
    justify-content:center;
    align-items:center;
}

.profile::before{
    content:"";
    position:absolute;
    width:430px;
    height:430px;
    border-radius:50%;
    background:radial-gradient(
        circle,
        rgba(59,130,246,.35),
        transparent 70%
    );
    filter:blur(35px);
    z-index:-1;
}

.avatar{
    width:360px;
    height:360px;
    object-fit:cover;
    border-radius:50%;
    border:6px solid rgba(255,255,255,.08);
    box-shadow:0 0 60px rgba(59,130,246,.35);
    transition:.35s ease;
}

.avatar:hover{
    transform:scale(1.04) rotate(1deg);
    box-shadow:0 0 80px rgba(59,130,246,.5);
}

/* MOBILE */

@media(max-width:900px){

.hero{
    padding-top:130px;
}

.hero-grid{
    grid-template-columns:1fr;
    text-align:center;
}

.hero h1{
    font-size:48px;
}

.buttons{
    justify-content:center;
}

.status{
    margin-left:auto;
    margin-right:auto;
}

.stats{
    justify-content:center;
}

.profile{
    order:-1;
    margin-bottom:40px;
}

.profile::before{
    width:300px;
    height:300px;
}

.avatar{
    width:260px;
    height:260px;
}

}

</style>