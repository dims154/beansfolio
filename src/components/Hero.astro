---
import profile from "../assets/images/profile.jpg";
---

<section class="hero">

<div class="container hero-grid">

<div>

<span class="tag">

👋 Halo, saya

</span>

<h1>

Muhammad Ilham
<br>

<span>Dimas Meidi</span>

</h1>

<p>

Mahasiswa Sistem Informasi yang fokus pada pengembangan
website modern menggunakan Laravel, PHP, JavaScript,
MySQL, Bootstrap, Tailwind CSS, dan Astro.

</p>

<div class="buttons">

<a
href="https://github.com/dims154"
target="_blank"
class="btn btn-primary">

GitHub

</a>

<a
href="#projects"
class="btn btn-outline">

Lihat Project

</a>

</div>

</div>

<div class="profile">

    <img
        src={profile.src}
        alt="Muhammad Ilham Dimas Meidi"
        class="avatar"
    />

</div>

</div>

</section>

<style>

.hero{

padding-top:170px;

min-height:100vh;

display:flex;

align-items:center;

}

.hero-grid{

display:grid;

grid-template-columns:1fr 450px;

align-items:center;

gap:60px;

}

.hero h1{

font-size:68px;

line-height:1.1;

margin:20px 0;

}

.hero h1 span{

color:var(--primary);

}

.hero p{

color:var(--muted);

line-height:1.9;

margin:25px 0;

max-width:620px;

}

.buttons{

display:flex;

gap:20px;

margin-top:35px;

}

.profile{

display:flex;

justify-content:center;

}

.profile{
    display:flex;
    justify-content:center;
}

.avatar{
    width:360px;
    height:360px;
    object-fit:cover;
    border-radius:50%;
    border:6px solid rgba(255,255,255,.08);
    box-shadow:0 0 60px rgba(59,130,246,.35);
    transition:.3s;
}

.avatar:hover{
    transform:scale(1.03);
}

@media(max-width:900px){

.hero-grid{

grid-template-columns:1fr;

text-align:center;

}

.hero h1{

font-size:48px;

}

.buttons{

justify-content:center;

}

.profile{

order:-1;

}

.avatar{

width:260px;

height:260px;

}

}

</style>