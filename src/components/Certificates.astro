---
const certificates = [
  {
    title: "Belajar Pemrograman Python",
    issuer: "Dicoding Indonesia",
    year: "2026",
    image: "/certificates/python.jpg",
    credential: "/certificates/python.pdf",
    skills: [
      "Python",
      "OOP",
      "Algorithm"
    ]
  },

  {
    title: "Membangun Aplikasi Generative AI",
    issuer: "Dicoding Indonesia",
    year: "2026",
    image: "/certificates/gen-ai.jpg",
    credential: "/certificates/gen-ai.pdf",
    skills: [
      "Generative AI",
      "LLM",
      "Prompt Engineering"
    ]
  },

  {
    title: "Belajar Data Science",
    issuer: "Dicoding Indonesia",
    year: "2026",
    image: "/certificates/data-science.jpg",
    credential: "/certificates/data-science.pdf",
    skills: [
      "Python",
      "Pandas",
      "Machine Learning"
    ]
  },

 
];
---

<section id="certificates">

    <div class="certificate-bg">

        <span class="blur blur-1"></span>
        <span class="blur blur-2"></span>
        <span class="grid-pattern"></span>

    </div>

    <div class="container">

        <span class="section-tag">

            🏆 Achievement

        </span>

        <h2>

            My
            <span>Certificates</span>

        </h2>

        <p class="section-desc">

            Berikut merupakan beberapa sertifikat yang saya peroleh
            selama mempelajari Web Development, Artificial Intelligence,
            Data Science, Cloud Computing, serta berbagai teknologi
            lainnya.

        </p>

        <div class="certificate-grid">

            {certificates.map((item) => (

                <article class="certificate-card">

                    <div class="certificate-image">

                        <img
                            src={item.image}
                            alt={item.title}
                            loading="lazy"
                        />

                        <div class="certificate-overlay">

                            <span>

                                View Certificate

                            </span>

                        </div>

                    </div>

                    <div class="certificate-content">

                        <span class="issuer">

                            {item.issuer}

                        </span>

                        <h3>

                            {item.title}

                        </h3>

                        <span class="year">

                            Issued {item.year}

                        </span>

                        <div class="skills">

                            {item.skills.map((skill) => (

                                <span>

                                    {skill}

                                </span>

                            ))}

                        </div>

                        <a
                            href={item.credential}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="certificate-btn"
                        >

                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >

                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 16V4m0 12l-4-4m4 4l4-4M4 20h16"
                                />

                            </svg>

                            <span>

                                View Certificate

                            </span>

                        </a>

                    </div>

                </article>

            ))}

        </div>

    </div>

</section>

<style>
    /* ==========================================================
   CERTIFICATES
========================================================== */

#certificates{

    position:relative;

    overflow:hidden;

    padding:120px 0;

}

#certificates .container{

    width:min(1200px,92%);

    margin:auto;

    position:relative;

    z-index:2;

}

/* ==========================================================
   BACKGROUND
========================================================== */

.certificate-bg{

    position:absolute;

    inset:0;

    z-index:0;

    pointer-events:none;

}

.blur{

    position:absolute;

    border-radius:50%;

    filter:blur(120px);

    opacity:.28;

    animation:floatGlow 10s ease-in-out infinite;

}

.blur-1{

    width:340px;

    height:340px;

    background:#3b82f6;

    left:-140px;

    top:-120px;

}

.blur-2{

    width:320px;

    height:320px;

    background:#06b6d4;

    right:-120px;

    bottom:-100px;

    animation-delay:4s;

}

.grid-pattern{

    position:absolute;

    inset:0;

    background-image:

        linear-gradient(

            rgba(255,255,255,.03) 1px,

            transparent 1px

        ),

        linear-gradient(

            90deg,

            rgba(255,255,255,.03) 1px,

            transparent 1px

        );

    background-size:42px 42px;

    mask-image:

        radial-gradient(circle,black,transparent 90%);

}

/* ==========================================================
   TITLE
========================================================== */

.section-tag{

    display:inline-flex;

    align-items:center;

    gap:10px;

    padding:8px 20px;

    border-radius:999px;

    background:

        rgba(59,130,246,.12);

    border:

        1px solid rgba(59,130,246,.20);

    color:#60a5fa;

    font-size:.9rem;

    font-weight:600;

    margin-bottom:20px;

}

#certificates h2{

    font-size:clamp(2.7rem,5vw,4rem);

    line-height:1.1;

    margin-bottom:20px;

    font-weight:700;

}

#certificates h2 span{

    background:

        linear-gradient(

            135deg,

            #3b82f6,

            #06b6d4

        );

    -webkit-background-clip:text;

    -webkit-text-fill-color:transparent;

}

.section-desc{

    max-width:760px;

    line-height:1.9;

    color:var(--muted);

    margin-bottom:65px;

}

/* ==========================================================
   GRID
========================================================== */

.certificate-grid{

    display:grid;

    grid-template-columns:

        repeat(auto-fit,minmax(340px,1fr));

    gap:35px;

}

/* ==========================================================
   CARD
========================================================== */

.certificate-card{

    position:relative;

    display:flex;

    flex-direction:column;

    overflow:hidden;

    border-radius:26px;

    background:

        rgba(255,255,255,.05);

    border:

        1px solid rgba(255,255,255,.08);

    backdrop-filter:

        blur(20px);

    transition:

        transform .35s,

        border-color .35s,

        box-shadow .35s;

}

.certificate-card::before{

    content:"";

    position:absolute;

    inset:0;

    border-radius:26px;

    padding:1px;

    background:

        linear-gradient(

            135deg,

            rgba(59,130,246,.45),

            rgba(6,182,212,.25),

            rgba(255,255,255,.05)

        );

    -webkit-mask:

        linear-gradient(#fff 0 0) content-box,

        linear-gradient(#fff 0 0);

    -webkit-mask-composite:xor;

            mask-composite:exclude;

    opacity:0;

    transition:.45s;

    pointer-events:none;

}

.certificate-card::after{

    content:"";

    position:absolute;

    width:180px;

    height:180px;

    right:-80px;

    top:-80px;

    border-radius:50%;

    background:

        radial-gradient(

            rgba(59,130,246,.18),

            transparent 70%

        );

    opacity:0;

    transition:.45s;

    pointer-events:none;

}
/* ==========================================================
   IMAGE
========================================================== */

.certificate-image{

    position:relative;

    height:230px;

    overflow:hidden;

    background:#0f172a;

}

.certificate-image img{

    width:100%;

    height:100%;

    object-fit:cover;

    display:block;

    transition:

        transform .6s ease,

        filter .6s ease;

}

.certificate-overlay{

    position:absolute;

    inset:0;

    display:flex;

    justify-content:center;

    align-items:center;

    background:

        rgba(15,23,42,.65);

    backdrop-filter:blur(4px);

    opacity:0;

    transition:.35s;

}

.certificate-overlay span{

    color:white;

    font-size:1rem;

    font-weight:600;

    letter-spacing:.4px;

}

/* ==========================================================
   CONTENT
========================================================== */

.certificate-content{

    display:flex;

    flex-direction:column;

    flex:1;

    padding:28px;

}

.issuer{

    color:#60a5fa;

    font-size:.9rem;

    font-weight:600;

    margin-bottom:14px;

}

.certificate-content h3{

    font-size:1.45rem;

    line-height:1.4;

    margin-bottom:14px;

    font-weight:700;

}

.year{

    color:var(--muted);

    margin-bottom:24px;

}

/* ==========================================================
   SKILLS
========================================================== */

.skills{

    display:flex;

    flex-wrap:wrap;

    gap:10px;

    margin-bottom:30px;

    min-height:72px;

}

.skills span{

    display:inline-flex;

    align-items:center;

    justify-content:center;

    height:34px;

    padding:0 16px;

    white-space:nowrap;

    border-radius:999px;

    background:rgba(59,130,246,.12);

    border:1px solid rgba(59,130,246,.20);

    color:#93c5fd;

    font-size:.82rem;

    line-height:1;

    transition:.3s;

}

.skills span:hover{

    transform:translateY(-3px);

    color:white;

    background:

        rgba(59,130,246,.20);

    border-color:

        rgba(59,130,246,.45);

}

/* ==========================================================
   BUTTON
========================================================== */

.certificate-btn{

    margin-top:auto;

    position:relative;

    overflow:hidden;

    display:flex;

    align-items:center;

    justify-content:center;

    gap:12px;

    width:100%;

    height:58px;

    border-radius:16px;

    text-decoration:none;

    color:white;

    font-weight:600;

    background:

        linear-gradient(

            135deg,

            #3b82f6,

            #06b6d4

        );

    transition:

        .35s;

}

.certificate-btn svg{

    width:20px;

    height:20px;

    transition:.35s;

}

.certificate-btn::before{

    content:"";

    position:absolute;

    top:0;

    left:-120%;

    width:60%;

    height:100%;

    background:

        linear-gradient(

            90deg,

            transparent,

            rgba(255,255,255,.35),

            transparent

        );

    transition:.8s;

}

/* ==========================================================
   HOVER
========================================================== */

.certificate-card:hover{

    transform:translateY(-10px);

    border-color:

        rgba(59,130,246,.30);

    box-shadow:

        0 20px 40px rgba(0,0,0,.30),

        0 10px 35px rgba(59,130,246,.15);

}

.certificate-card:hover::before{

    opacity:1;

}

.certificate-card:hover::after{

    opacity:1;

}

.certificate-card:hover img{

    transform:scale(1.08);

    filter:brightness(1.05);

}

.certificate-card:hover .certificate-overlay{

    opacity:1;

}

.certificate-btn:hover{

    transform:translateY(-3px);

    box-shadow:

        0 12px 30px rgba(59,130,246,.35);

}

.certificate-btn:hover::before{

    left:150%;

}

.certificate-btn:hover svg{

    transform:translateX(4px);

}

/* ==========================================================
   ANIMATION
========================================================== */

@keyframes floatGlow{

    0%{

        transform:

            translate(0,0);

    }

    50%{

        transform:

            translate(20px,35px);

    }

    100%{

        transform:

            translate(0,0);

    }

}

/* ==========================================================
   RESPONSIVE
========================================================== */

@media(max-width:992px){

    #certificates{

        padding:90px 0;

    }

    .certificate-grid{

        grid-template-columns:

            repeat(auto-fit,minmax(300px,1fr));

    }

}

@media(max-width:768px){

    #certificates h2{

        font-size:2.5rem;

    }

    .certificate-image{

        height:210px;

    }

    .certificate-content{

        padding:22px;

    }

}

@media(max-width:576px){

    .certificate-grid{

        grid-template-columns:1fr;

    }

    .certificate-btn{

        height:54px;

        font-size:.95rem;

    }

    .skills{

        min-height:auto;

    }

}

</style>