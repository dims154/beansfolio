---
const projects = [
  {
    title: "Sistem Informasi Klinik",
    year: "2026",
    featured: true,
    image: "/projects/klinik.png",
    description:
      "Website manajemen klinik berbasis Laravel untuk mengelola pasien, dokter, administrasi, dan laporan.",
    tech: ["Laravel", "Bootstrap", "MySQL"],
    github: "https://github.com/dims154",
    demo: "#"
  },

  {
    title: "WhatsApp AI Bot",
    year: "2026",
    featured: false,
    image: "/projects/bot.png",
    description:
      "Bot WhatsApp berbasis Node.js dengan AI dan dashboard administrasi.",
    tech: ["Node.js", "Express", "SQLite"],
    github: "https://github.com/dims154",
    demo: "#"
  },

  {
    title: "Portfolio Website",
    year: "2026",
    featured: false,
    image: "/projects/portfolio.png",
    description:
      "Portfolio modern menggunakan Astro dengan desain glassmorphism.",
    tech: ["Astro", "CSS", "JavaScript"],
    github: "https://github.com/dims154",
    demo: "#"
  }
];
---

<section id="projects">

<div class="container">

<span class="tag">
Portfolio
</span>

<h2 class="title">
Featured Projects
</h2>

<div class="projects">

{
projects.map(project => (

<div class="project-card">

<div class="image">

<img
src={project.image}
alt={project.title}
/>

{
project.featured && (
<span class="featured">
⭐ Featured
</span>
)
}

</div>

<div class="content">

<div class="header">

<h3>{project.title}</h3>

<span class="year">
{project.year}
</span>

</div>

<p>
{project.description}
</p>

<div class="tech">

{
project.tech.map(item => (
<span>{item}</span>
))
}

</div>

<div class="buttons">

<a
href={project.github}
target="_blank"
class="btn btn-primary">

Source Code

</a>

<a
href={project.demo}
class="btn btn-outline">

Live Demo

</a>

</div>

</div>

</div>

))
}

</div>

</div>

</section>

<style>

.projects{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(340px,1fr));
gap:35px;
margin-top:55px;
}

.project-card{
overflow:hidden;
border-radius:24px;
background:rgba(255,255,255,.04);
border:1px solid rgba(255,255,255,.08);
transition:.35s;
backdrop-filter:blur(18px);
}

.project-card:hover{
transform:translateY(-10px);
box-shadow:0 25px 60px rgba(59,130,246,.18);
border-color:var(--primary);
}

.image{
position:relative;
overflow:hidden;
}

.image img{
width:100%;
height:230px;
object-fit:cover;
transition:.45s;
}

.project-card:hover img{
transform:scale(1.08);
}

.featured{
position:absolute;
top:15px;
left:15px;
padding:8px 14px;
border-radius:999px;
background:#f59e0b;
color:white;
font-size:13px;
font-weight:600;
}

.content{
padding:28px;
}

.header{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:18px;
}

.header h3{
font-size:24px;
}

.year{
color:var(--muted);
font-size:14px;
}

.content p{
line-height:1.8;
color:var(--muted);
margin-bottom:22px;
}

.tech{
display:flex;
gap:10px;
flex-wrap:wrap;
margin-bottom:28px;
}

.tech span{
padding:8px 14px;
border-radius:999px;
background:rgba(59,130,246,.12);
border:1px solid rgba(59,130,246,.25);
font-size:13px;
color:#93c5fd;
}

.buttons{
display:flex;
gap:15px;
flex-wrap:wrap;
}

@media(max-width:768px){

.projects{
grid-template-columns:1fr;
}

}

</style>