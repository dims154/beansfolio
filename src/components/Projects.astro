---
const projects = [
  {
    title: "Sistem Informasi Klinik",
    year: "2026",
    featured: true,
    image: "/projects/klinik-dashboard.png",
    description:
      "Website Sistem Informasi Klinik berbasis Laravel untuk mengelola data dokter, pasien, transaksi, pendapatan, serta laporan melalui dashboard interaktif.",
    tech: ["Laravel", "Bootstrap", "MySQL"],
    github: "https://github.com/dims154/klinik_10ps4",
  },

  {
    title: "WhatsApp AI Bot",
    year: "2026",
    featured: true,
    image: "/projects/bot-whatsapp.png",
    description:
      "Bot WhatsApp berbasis Node.js menggunakan Baileys dengan integrasi AI untuk auto reply, manajemen grup, dan dashboard administrasi.",
    tech: ["Node.js", "Baileys", "Express", "SQLite"],
    github: "https://github.com/dims154/bot.whatsapp.git",
  },

  {
    title: "Portfolio Website",
    year: "2026",
    featured: false,
    image: "/projects/portofolio.png",
    description:
      "Website portfolio modern yang dibangun menggunakan Astro dengan desain glassmorphism, responsive, dan performa tinggi.",
    tech: ["Astro", "JavaScript", "CSS"],
    github: "https://github.com/dims154/beansfolio",
  },
];
---

<section id="projects">
  <div class="container">

    <span class="section-tag">Portfolio</span>

    <h2>Featured Projects</h2>

    <p class="section-desc">
      Beberapa project yang telah saya kerjakan selama belajar dan mengembangkan
      aplikasi web modern.
    </p>

    <div class="project-grid">

      {projects.map((project) => (

        <article class="project-card">

          <div class="project-image">

            <img
              src={project.image}
              alt={project.title}
              loading="lazy"
            />

            <div class="overlay">
              <span>View Project</span>
            </div>

            {project.featured && (
              <span class="badge">
                ⭐ Featured
              </span>
            )}

          </div>

          <div class="project-content">

            <div class="project-header">
              <h3>{project.title}</h3>
              <span>{project.year}</span>
            </div>

            <p>{project.description}</p>

            <div class="tech">

              {project.tech.map((item) => (
                <span>{item}</span>
              ))}

            </div>
<a
  href={project.github}
  target="_blank"
  rel="noopener noreferrer"
  class="project-btn"
>

  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
  >
    <path d="M12 .5C5.648.5.5 5.648.5 12c0 5.084 3.292 9.388 7.865 10.91.575.105.785-.25.785-.555 0-.275-.01-1.005-.015-1.975-3.2.695-3.875-1.545-3.875-1.545-.525-1.335-1.285-1.69-1.285-1.69-1.05-.72.08-.705.08-.705 1.16.08 1.77 1.195 1.77 1.195 1.03 1.765 2.705 1.255 3.365.96.105-.745.405-1.255.735-1.545-2.555-.29-5.24-1.28-5.24-5.695 0-1.255.45-2.28 1.19-3.085-.12-.29-.515-1.46.115-3.045 0 0 .97-.31 3.18 1.18a10.94 10.94 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.585.235 2.755.115 3.045.74.805 1.19 1.83 1.19 3.085 0 4.425-2.69 5.4-5.255 5.685.415.355.785 1.06.785 2.14 0 1.545-.015 2.79-.015 3.17 0 .31.205.665.79.55A11.51 11.51 0 0 0 23.5 12C23.5 5.648 18.352.5 12 .5z"/>
  </svg>

  <span>View on GitHub</span>

</a>

          </div>

        </article>

      ))}

    </div>

  </div>
</section>

<style>

#projects{
    padding:120px 0;
}

.section-tag{
    display:inline-block;
    padding:8px 18px;
    border-radius:999px;
    background:rgba(59,130,246,.12);
    color:#60a5fa;
    margin-bottom:20px;
}

#projects h2{
    font-size:48px;
    margin-bottom:16px;
}

.section-desc{
    max-width:700px;
    color:var(--muted);
    line-height:1.8;
}

.project-grid{
    margin-top:60px;
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(340px,1fr));
    gap:35px;
}

.project-card{
    display:flex;
    flex-direction:column;

    background:rgba(255,255,255,.05);
    border:1px solid rgba(255,255,255,.08);
    backdrop-filter:blur(20px);
    border-radius:24px;
    overflow:hidden;

    transition:.35s;
}

.project-card:hover{
    transform:translateY(-10px);
    border-color:#3b82f6;
    box-shadow:0 25px 60px rgba(59,130,246,.18);
}

.project-image{
    position:relative;
    overflow:hidden;
    height:220px;
    background:#0f172a;
}

.project-image img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:.45s;
}

.project-card:hover img{
    transform:scale(1.08);
}

.overlay{
    position:absolute;
    inset:0;
    display:flex;
    justify-content:center;
    align-items:center;
    background:rgba(15,23,42,.55);
    opacity:0;
    transition:.35s;
}

.project-card:hover .overlay{
    opacity:1;
}

.overlay span{
    color:white;
    font-weight:600;
    font-size:18px;
}

.badge{
    position:absolute;
    top:16px;
    right:16px;
    background:#f59e0b;
    color:white;
    padding:8px 14px;
    border-radius:999px;
    font-size:13px;
    font-weight:700;
}

.project-content{
    display:flex;
    flex-direction:column;
    flex:1;

    padding:28px;
}

.project-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:18px;
}

.project-header h3{
    font-size:26px;
}

.project-header span{
    color:var(--muted);
}

.project-content p{
    line-height:1.8;
    color:var(--muted);
    margin-bottom:24px;
}

.tech{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
    margin-bottom:30px;
}

.tech span{
    padding:8px 15px;
    border-radius:999px;
    background:rgba(59,130,246,.12);
    color:#93c5fd;
    border:1px solid rgba(59,130,246,.2);
    font-size:13px;
}

.project-btn{

    margin-top:auto;

    display:flex;
    justify-content:center;
    align-items:center;
    gap:12px;

    width:100%;
    height:56px;

    border-radius:16px;

    background:linear-gradient(
        135deg,
        #3b82f6,
        #06b6d4
    );

    color:#fff;
    text-decoration:none;

    font-size:15px;
    font-weight:600;

    transition:all .3s ease;

}

.project-btn svg{

    width:20px;
    height:20px;

    transition:.3s;

}

.project-btn:hover{

    transform:translateY(-3px);

    background:linear-gradient(
        135deg,
        #2563eb,
        #0891b2
    );

    box-shadow:
        0 12px 30px rgba(59,130,246,.35);

}

.project-btn:hover svg{

    transform:scale(1.08);

}


@media(max-width:768px){

.project-grid{
}
grid-template-columns:1fr;

.project-header{
flex-direction:column;
align-items:flex-start;
gap:8px;
}


}

</style>